# Build outputs
# output/ 是探针跑图留下的截图与状态转储（非构建产物、非源码）。
# 忽略它是为了让 `git status --short` 保持"干净=无事"的信号强度——
# 夜间无人值守时，一个常驻的 ?? 条目会训练人把噪音当背景音。
output/
brogueweb/dist/
brogueweb/emsdk/
brogueweb/node_modules/
brogueweb/android/app/build/
brogueweb/android/.gradle/
brogueweb/android/local.properties

# Compiled binaries (but keep source assets)
BrogueCE-master/macos/build/
BrogueCE-master/linux/bin/
BrogueCE-master/windows/bin/

# Large binary files and compiled test utilities in bin/
BrogueCE-master/bin/*.ttf
BrogueCE-master/bin/*.png
BrogueCE-master/bin/parse_test*
BrogueCE-master/bin/test_*

# APK & Android intermediates
*.apk
*.aab
*.keystore

# Gradle
.gradle/
*.gradle.kts.bak

# CMake
cmake-build-debug/
cmake-build-release/

# OS files
Thumbs.db
*.log

# npm
npm-debug.log
yarn-error.log

# git worktree（轮次隔离用，不入库）
wt-*/
